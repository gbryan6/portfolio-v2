# SMTP para o formulário de /fale-comigo (src/app/api/contact/route.ts).
# Copie para .env.local — .env*.local já está no .gitignore.
#
# Gmail: use uma "Senha de app" (myaccount.google.com/apppasswords),
# nunca a senha da conta.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Caixa que recebe as mensagens do formulário.
CONTACT_TO=voce@gmail.com

# Opcional — remetente do envelope. Padrão: SMTP_USER.
# Muitos provedores só aceitam um From igual ao usuário autenticado.
CONTACT_FROM=voce@gmail.com
